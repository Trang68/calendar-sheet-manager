PORT=8080
NODE_ENV=production

# Service account JSON as a single-line JSON string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_TIMEZONE=Asia/Ho_Chi_Minh
SHEET_GID=0

# Optional: set to protect API calls from your web UI
APP_TOKEN=change-me

# Session and account settings for /app login
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=12

# Default lesson fee (VND) if not overridden per student
DEFAULT_SESSION_RATE=300000

# Accounts: JSON array, one line
APP_USERS_JSON=[{"username":"teacher","password":"change-me","role":"teacher","displayName":"Co Trang"},{"username":"student.a","password":"change-me","role":"student","displayName":"Hoc vien A","studentKey":"Hoc vien A"}]

# Student rates: JSON object, one line. Key should match student name/event key
STUDENT_RATE_JSON={"Hoc vien A":300000,"Hoc vien B":280000}
